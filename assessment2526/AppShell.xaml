<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="assessment2526.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:assessment2526"
    Shell.FlyoutBehavior="Disabled"
    Title="assessment2526"

    Shell.TabBarBackgroundColor="#2B2B2B"
    Shell.TabBarForegroundColor="{StaticResource PrimaryRed}"
    Shell.TabBarUnselectedColor="Gray"
    Shell.TitleColor="{StaticResource PrimaryRed}">

    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>

        <Tab Title="Dashboard" Icon="dashboard.png">
            <ShellContent ContentTemplate="{DataTemplate local:Dashboard}" />
        </Tab>

        <Tab Title="Journal" Icon="journal.png">
            <ShellContent ContentTemplate="{DataTemplate local:Dashboard}" />
        </Tab>

        <Tab Title="Profile" Icon="profile.png">
            <ShellContent ContentTemplate="{DataTemplate local:Dashboard}" />
        </Tab>

        <Tab Title="Settings" Icon="settings.png">
            <ShellContent ContentTemplate="{DataTemplate local:Dashboard}" />
        </Tab>
    </TabBar>

</Shell>
