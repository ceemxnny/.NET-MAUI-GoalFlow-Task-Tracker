<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="assessment2526.MainPage"
             Title="Home">


        <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" 
        Padding="40, 40, 30, 30" 
        BackgroundColor="{StaticResource PageGrey}">
        
        <VerticalStackLayout Grid.Row="1" Spacing="5" HorizontalOptions="Center">
        <Image Source="title.png" 
           HeightRequest="120" 
           HorizontalOptions="Center"
           Margin="0,0,0,5" />

        </VerticalStackLayout>

        <Image Grid.Row="2" 
               Source="goalflowlogo.png" 
               HeightRequest="250" 
               WidthRequest="300"
               TranslationX="-15"
               TranslationY="-75"
               Margin="0,40" />

        <Label Grid.Row="3" 
               Text="Hello Colin, Welcome Back." 
               TextColor="White" 
               FontSize="24" 
               FontAttributes="Bold"
               TranslationY="-75"
               HorizontalOptions="Center" 
               Margin="0,0,0,50"/>

        <Button Grid.Row="4" 
                Text="Enter" 
                TranslationY="-75"
                WidthRequest="300"
                HeightRequest="80"
                Clicked="OnEnterClicked" />
        
    </Grid>

</ContentPage>
