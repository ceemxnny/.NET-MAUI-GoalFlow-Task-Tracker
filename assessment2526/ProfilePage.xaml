<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:assessment2526.ViewModels"
             x:Class="assessment2526.ProfilePage"
             Title="Profile"
            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#5A5A5A}">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center" Margin="0,-60,0,0">

        <Border Stroke="#B22222" 
                StrokeThickness="3" 
                StrokeShape="RoundRectangle 100" 
                HeightRequest="250" 
                WidthRequest="250" 
                HorizontalOptions="Center"
                BackgroundColor="Transparent">
            <Image Source="{Binding ProfileImage}" 
                   Aspect="AspectFill" />
        </Border>

        <Border BackgroundColor="White" 
                Stroke="Transparent" 
                StrokeShape="RoundRectangle 30" 
                Padding="20, 30, 20, 20"
                Margin="10, 0">
            
            <VerticalStackLayout Spacing="20">
                
                <Label Text="{Binding FullName}" 
                       TextColor="Black" 
                       FontSize="22" 
                       FontFamily="monospace"
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,10"/>

                <Grid RowDefinitions="Auto, Auto, Auto" 
                      ColumnDefinitions="*, 1.5*" 
                      RowSpacing="15" 
                      ColumnSpacing="15">


                    <Border Grid.Row="0" Grid.Column="0" 
                        BackgroundColor="#B87373" 
                        Stroke="#8B0000" 
                        StrokeThickness="2" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10">
                        
                        <Label Text="Username" 
                            TextColor="Black" 
                            FontFamily="monospace" 
                            FontAttributes="Bold" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" 
                        BackgroundColor="#E0E0E0" 
                        Stroke="#B22222" 
                        StrokeThickness="2" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10">

                        <Label Text="{Binding Username}" 
                            TextColor="Black" 
                            FontFamily="monospace" 
                            FontAttributes="Bold" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" 
                        BackgroundColor="#B87373" 
                        Stroke="#8B0000" 
                        StrokeThickness="2" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10">

                        <Label Text="User ID" 
                            TextColor="Black" 
                            FontFamily="monospace" 
                            FontAttributes="Bold" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" 
                        BackgroundColor="#E0E0E0" 
                        Stroke="#B22222" 
                        StrokeThickness="2" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10">

                        <Label Text="{Binding UserId}" 
                            TextColor="Black" 
                            FontFamily="monospace" 
                            FontAttributes="Bold" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" 
                        BackgroundColor="#B87373" 
                        Stroke="#8B0000" 
                        StrokeThickness="2" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10">

                        <Label Text="DOB" 
                            TextColor="Black" 
                            FontFamily="monospace" 
                            FontAttributes="Bold" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" 
                        BackgroundColor="#E0E0E0" 
                        Stroke="#B22222" 
                        StrokeThickness="2" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10">

                        <Label Text="{Binding DateOfBirth}" 
                            TextColor="Black" 
                            FontFamily="monospace" 
                            FontAttributes="Bold" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"/>
                    </Border>

                </Grid>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0, 20, 0, 10">
                    <Image Source="instagram.png" HeightRequest="45" WidthRequest="45">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding OpenLinkCommand}" 
                                CommandParameter="https://www.instagram.com" />
                        </Image.GestureRecognizers>
                    </Image>
                            
                    <Image Source="x.png" HeightRequest="45" WidthRequest="45">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding OpenLinkCommand}" 
                                CommandParameter="https://x.com/i/flow/login" />
                        </Image.GestureRecognizers>
                    </Image>

                    <Image Source="facebook.png" HeightRequest="45" WidthRequest="45">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding OpenLinkCommand}" 
                                CommandParameter="https://www.facebook.com/login" />
                        </Image.GestureRecognizers>
                    </Image>

                </HorizontalStackLayout>

                <Label Text="{Binding JoinDate}" 
                       TextColor="Black" 
                       FontSize="12" 
                       FontFamily="monospace"
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>